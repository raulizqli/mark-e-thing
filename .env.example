# // .env.example
# MarkeThing — Phase 1.5

NODE_ENV=development
API_PORT=3001
WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# PostgreSQL (Supabase direct connection recommended for migrations)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/markething"

# Auth: `dev` (local demo user) | `supabase` (JWT required)
AUTH_MODE="dev"
NEXT_PUBLIC_AUTH_MODE="dev"
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_JWT_SECRET=""

# Dev auth bypass (used when AUTH_MODE=dev)
DEV_USER_ID="00000000-0000-4000-8000-000000000001"
DEV_USER_EMAIL="demo@markething.app"
DEV_USER_NAME="Demo User"

# Free-plan generation quotas
FREE_MONTHLY_CONTENT_QUOTA=50
FREE_MONTHLY_IMAGE_QUOTA=20

# AI providers (auto = pick first available key; mock when none)
AI_CONTENT_PROVIDER="auto"
AI_IMAGE_PROVIDER="auto"

GEMINI_API_KEY=""
GEMINI_CONTENT_MODEL="gemini-2.0-flash"
GEMINI_IMAGE_MODEL="gemini-2.0-flash-preview-image-generation"

GROQ_API_KEY=""
GROQ_CONTENT_MODEL="llama-3.3-70b-versatile"

TOGETHER_API_KEY=""
TOGETHER_IMAGE_MODEL="black-forest-labs/FLUX.1-schnell"

OPENAI_API_KEY="sk-..."
OPENAI_CONTENT_MODEL="gpt-4o-mini"
OPENAI_IMAGE_MODEL="dall-e-3"

# S3-compatible storage — if S3_BUCKET + keys are set, API uses S3; otherwise local
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""

# LinkedIn OAuth
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_REDIRECT_URI="http://localhost:3001/oauth/linkedin/callback"

# Meta OAuth (Facebook Pages + Instagram Business)
META_APP_ID=""
META_APP_SECRET=""
META_REDIRECT_URI="http://localhost:3001/oauth/meta/callback"

# X (Twitter) OAuth 2.0 PKCE
X_CLIENT_ID=""
X_CLIENT_SECRET=""
X_REDIRECT_URI="http://localhost:3001/oauth/x/callback"

# WhatsApp uses per-company Cloud API token via UI (no global secret required)
WHATSAPP_GRAPH_VERSION="v21.0"
OAUTH_STATE_SECRET="markething-oauth-dev-secret"

# Optional n8n webhook for future automation (unused in Phase 1.5)
N8N_WEBHOOK_URL=""
