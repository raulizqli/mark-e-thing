# // .env.example

# Application Execution Settings
PORT=3000
NODE_ENV=development

# ---------------------------------------------------------------------------
# Database — Supabase (recommended) or any PostgreSQL host
# ---------------------------------------------------------------------------
# 1. Create a project at https://supabase.com
# 2. Project Settings → Database → Connection string → URI
# 3. Copy the "Direct connection" string (port 5432) — required for Prisma migrations
#
# Example (replace [PASSWORD] and [PROJECT-REF] with your values):
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"
#
# If your password contains special characters, URL-encode them:
#   / → %2F    @ → %40    # → %23    : → %3A
# Example: password "abc/def" → abc%2Fdef
#
# For production you may also use a pooled URL (port 6543) at runtime; keep a direct
# URL for migrations. See README.md for the two-URL setup.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# Optional: direct URL when DATABASE_URL uses Supabase pooler (port 6543) at runtime
# DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
# Redis — required for BullMQ job queues
# ---------------------------------------------------------------------------
# Local: redis://127.0.0.1:6379
# Cloud (Upstash free tier): https://upstash.com → create DB → copy Redis URL
REDIS_URL="redis://default:[PASSWORD]@[HOST].upstash.io:6379"

# Google Places API Credentials (New Places API Framework)
GOOGLE_PLACES_API_KEY="your_google_places_api_key_here"

# Agnostic AI Module Orchestration Engine
# Options: openai | gemini | claude
LLM_PROVIDER="openai"
LLM_API_KEY="your_llm_api_key_here"

# Rate Limiting Configuration Guardrails
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ---------------------------------------------------------------------------
# Supabase Auth (API JWT verification)
# ---------------------------------------------------------------------------
# Project Settings → API
# - Project URL → SUPABASE_URL
# - JWT Secret (Legacy / HS256) → SUPABASE_JWT_SECRET
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_JWT_SECRET="your_supabase_jwt_secret"

# Client Vite env lives in client/.env (see client/.env.example):
# VITE_SUPABASE_URL + VITE_SUPABASE_ANON_KEY
