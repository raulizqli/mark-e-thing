# // .env.example
# MarkeThing — Phase 1

NODE_ENV=development
API_PORT=3001
WEB_URL=http://localhost:3000

# PostgreSQL (Supabase direct connection recommended for migrations)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/markething"

# AI providers (auto = pick first available key; mock when none)
# Content: gemini | groq | openai | mock | auto
# Image:   gemini | together | openai | mock | auto
AI_CONTENT_PROVIDER="auto"
AI_IMAGE_PROVIDER="auto"

# Preferred free/cheap path (optional)
GEMINI_API_KEY=""
GEMINI_CONTENT_MODEL="gemini-2.0-flash"
GEMINI_IMAGE_MODEL="gemini-2.0-flash-preview-image-generation"

GROQ_API_KEY=""
GROQ_CONTENT_MODEL="llama-3.3-70b-versatile"

TOGETHER_API_KEY=""
TOGETHER_IMAGE_MODEL="black-forest-labs/FLUX.1-schnell"

# OpenAI (optional premium path)
OPENAI_API_KEY="sk-..."
OPENAI_CONTENT_MODEL="gpt-4o-mini"
OPENAI_IMAGE_MODEL="dall-e-3"

# S3-compatible storage (MinIO / Cloudflare R2 / AWS S3) — prepared; local storage used in MVP
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="markething"
S3_ACCESS_KEY_ID="minio"
S3_SECRET_ACCESS_KEY="minio123"
S3_PUBLIC_URL="http://localhost:9000/markething"

# Dev auth bypass (MVP only — not for external beta)
DEV_USER_ID="00000000-0000-4000-8000-000000000001"
DEV_USER_EMAIL="demo@markething.app"
DEV_USER_NAME="Demo User"

# Optional n8n webhook for future automation (unused in Phase 1)
N8N_WEBHOOK_URL=""
