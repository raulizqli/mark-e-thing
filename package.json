{
  "name": "business-prospect-finder",
  "version": "1.0.0",
  "description": "Enterprise Grade SaaS Business Discovery & Enrichment Engine",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "build": "npm run build:client && tsc",
    "build:client": "vite build --config client/vite.config.ts",
    "start:api": "PORT=5175 node dist/server.js",
    "dev": "concurrently -n api,gui -c blue,green \"tsx watch src/server.ts\" \"vite --config client/vite.config.ts --port 5176\"",
    "dev:local": "./dev.sh",
    "dev:api": "tsx watch src/server.ts",
    "dev:gui": "vite --config client/vite.config.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/client": "^5.11.0",
    "@supabase/supabase-js": "^2.110.7",
    "axios": "^1.6.8",
    "bullmq": "^5.4.0",
    "compression": "^1.7.4",
    "concurrently": "^10.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jose": "^6.2.3",
    "leaflet": "^1.9.4",
    "pino": "^8.19.0",
    "pino-http": "^11.0.0",
    "vite": "^8.1.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.0.0",
    "@types/supertest": "^7.2.0",
    "pino-pretty": "^11.0.0",
    "prisma": "^5.11.0",
    "supertest": "^7.2.2",
    "tsx": "^4.7.1",
    "typescript": "^5.4.2",
    "vitest": "^1.4.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
