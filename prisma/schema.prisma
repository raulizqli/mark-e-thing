// prisma/schema.prisma
// MarkeThing — Phase 1 domain model

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ContentType {
  FACEBOOK_POST
  INSTAGRAM_POST
  INSTAGRAM_CAROUSEL
  INSTAGRAM_STORY
  FACEBOOK_STORY
  WHATSAPP_STATUS
  LINKEDIN
  X
  BLOG
  EMAIL
  PROMOTION
}

enum ContentStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  FAILED
  ARCHIVED
}

enum KnowledgeType {
  PDF
  WORD
  IMAGE
  CATALOG
  MANUAL
  FAQ
  SUCCESS_CASE
  OTHER
}

enum PublishPlatform {
  FACEBOOK
  INSTAGRAM
  WHATSAPP
  LINKEDIN
  X
}

enum PublishJobStatus {
  PENDING
  QUEUED
  PUBLISHING
  SUCCEEDED
  FAILED
  CANCELLED
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  name      String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  companies Company[]

  @@map("users")
}

model Company {
  id                   String              @id @default(uuid())
  userId               String              @map("user_id")
  name                 String
  description          String?
  industry             String?             @map("giro")
  services             String[]            @default([])
  products             String[]            @default([])
  promotions           String[]            @default([])
  city                 String?
  website              String?
  socialFacebook       String?             @map("social_facebook")
  socialInstagram      String?             @map("social_instagram")
  socialLinkedin       String?             @map("social_linkedin")
  socialX              String?             @map("social_x")
  socialWhatsapp       String?             @map("social_whatsapp")
  primaryColor         String?             @map("primary_color")
  secondaryColor       String?             @map("secondary_color")
  accentColor          String?             @map("accent_color")
  logoUrl              String?             @map("logo_url")
  typography           String?
  targetAudience       String?             @map("target_audience")
  toneOfVoice          String?             @map("tone_of_voice")
  forbiddenWords       String[]            @default([]) @map("forbidden_words")
  preferredCtas        String[]            @default([]) @map("preferred_ctas")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  knowledgeDocuments   KnowledgeDocument[]
  contents             Content[]
  generatedImages      GeneratedImage[]
  calendarEntries      CalendarEntry[]
  socialConnections    SocialConnection[]
  publishJobs          PublishJob[]

  @@index([userId])
  @@map("companies")
}

model KnowledgeDocument {
  id           String        @id @default(uuid())
  companyId    String        @map("company_id")
  title        String
  type         KnowledgeType @default(OTHER)
  fileName     String        @map("file_name")
  mimeType     String        @map("mime_type")
  storageKey   String        @map("storage_key")
  storageUrl   String?       @map("storage_url")
  extractedText String?      @map("extracted_text") @db.Text
  metadata     Json?
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("knowledge_documents")
}

model Content {
  id              String           @id @default(uuid())
  companyId       String           @map("company_id")
  type            ContentType
  status          ContentStatus    @default(DRAFT)
  title           String
  copy            String           @db.Text
  cta             String?
  emojis          String[]         @default([])
  hashtags        String[]         @default([])
  imagePrompt     String?          @map("image_prompt") @db.Text
  seoKeywords     String[]         @default([]) @map("seo_keywords")
  currentVersion  Int              @default(1) @map("current_version")
  scheduledAt     DateTime?        @map("scheduled_at")
  publishedAt     DateTime?        @map("published_at")
  imageId         String?          @map("image_id")
  metadata        Json?
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  image           GeneratedImage?  @relation(fields: [imageId], references: [id], onDelete: SetNull)
  versions        ContentVersion[]
  calendarEntries CalendarEntry[]
  publishJobs     PublishJob[]

  @@index([companyId])
  @@index([status])
  @@index([scheduledAt])
  @@map("contents")
}

model ContentVersion {
  id          String   @id @default(uuid())
  contentId   String   @map("content_id")
  version     Int
  title       String
  copy        String   @db.Text
  cta         String?
  emojis      String[] @default([])
  hashtags    String[] @default([])
  imagePrompt String?  @map("image_prompt") @db.Text
  seoKeywords String[] @default([]) @map("seo_keywords")
  snapshot    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  content     Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([contentId, version])
  @@index([contentId])
  @@map("content_versions")
}

model GeneratedImage {
  id        String    @id @default(uuid())
  companyId String    @map("company_id")
  prompt    String    @db.Text
  storageKey String?  @map("storage_key")
  url       String?
  model     String
  createdAt DateTime  @default(now()) @map("created_at")

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contents  Content[]

  @@index([companyId])
  @@map("generated_images")
}

model CalendarEntry {
  id          String   @id @default(uuid())
  companyId   String   @map("company_id")
  contentId   String   @map("content_id")
  scheduledAt DateTime @map("scheduled_at")
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  content     Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([companyId, scheduledAt])
  @@index([contentId])
  @@map("calendar_entries")
}

model SocialConnection {
  id           String          @id @default(uuid())
  companyId    String          @map("company_id")
  platform     PublishPlatform
  externalId   String?         @map("external_id")
  displayName  String?         @map("display_name")
  accessToken  String?         @map("access_token") @db.Text
  refreshToken String?         @map("refresh_token") @db.Text
  metadata     Json?
  connectedAt  DateTime?       @map("connected_at")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  company      Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, platform])
  @@map("social_connections")
}

model PublishJob {
  id          String           @id @default(uuid())
  companyId   String           @map("company_id")
  contentId   String           @map("content_id")
  platform    PublishPlatform
  status      PublishJobStatus @default(PENDING)
  scheduledAt DateTime?        @map("scheduled_at")
  publishedAt DateTime?        @map("published_at")
  externalId  String?          @map("external_id")
  error       String?
  payload     Json?
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  content     Content          @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([contentId])
  @@map("publish_jobs")
}
