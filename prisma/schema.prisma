// prisma/schema.prisma
// MarkeThing — Phase 1 domain model

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ContentType {
  FACEBOOK_POST
  INSTAGRAM_POST
  INSTAGRAM_CAROUSEL
  INSTAGRAM_STORY
  FACEBOOK_STORY
  WHATSAPP_STATUS
  LINKEDIN
  X
  BLOG
  EMAIL
  PROMOTION
}

enum ContentStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  FAILED
  ARCHIVED
}

enum KnowledgeType {
  PDF
  WORD
  IMAGE
  CATALOG
  MANUAL
  FAQ
  SUCCESS_CASE
  OTHER
}

enum PublishPlatform {
  FACEBOOK
  INSTAGRAM
  WHATSAPP
  LINKEDIN
  X
}

enum PublishJobStatus {
  PENDING
  QUEUED
  PUBLISHING
  SUCCEEDED
  FAILED
  CANCELLED
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  name      String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  companies Company[]

  @@map("users")
}

model Company {
  id                   String              @id @default(uuid())
  userId               String              @map("user_id")
  name                 String
  description          String?
  industry             String?             @map("giro")
  services             String[]            @default([])
  products             String[]            @default([])
  promotions           String[]            @default([])
  city                 String?
  website              String?
  socialFacebook       String?             @map("social_facebook")
  socialInstagram      String?             @map("social_instagram")
  socialLinkedin       String?             @map("social_linkedin")
  socialX              String?             @map("social_x")
  socialWhatsapp       String?             @map("social_whatsapp")
  primaryColor         String?             @map("primary_color")
  secondaryColor       String?             @map("secondary_color")
  accentColor          String?             @map("accent_color")
  logoUrl              String?             @map("logo_url")
  typography           String?
  targetAudience       String?             @map("target_audience")
  toneOfVoice          String?             @map("tone_of_voice")
  forbiddenWords       String[]            @default([]) @map("forbidden_words")
  preferredCtas        String[]            @default([]) @map("preferred_ctas")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  knowledgeDocuments   KnowledgeDocument[]
  contents             Content[]
  generatedImages      GeneratedImage[]
  calendarEntries      CalendarEntry[]
  socialConnections    SocialConnection[]
  publishJobs          PublishJob[]
  aiSettings           CompanyAiSettings?
  metricsSnapshots     MetricsSnapshot[]
  agentRuns            AgentRun[]
  recommendations      Recommendation[]

  @@index([userId])
  @@map("companies")
}

model KnowledgeDocument {
  id           String        @id @default(uuid())
  companyId    String        @map("company_id")
  title        String
  type         KnowledgeType @default(OTHER)
  fileName     String        @map("file_name")
  mimeType     String        @map("mime_type")
  storageKey   String        @map("storage_key")
  storageUrl   String?       @map("storage_url")
  extractedText String?      @map("extracted_text") @db.Text
  metadata     Json?
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("knowledge_documents")
}

model Content {
  id              String           @id @default(uuid())
  companyId       String           @map("company_id")
  type            ContentType
  status          ContentStatus    @default(DRAFT)
  title           String
  copy            String           @db.Text
  cta             String?
  emojis          String[]         @default([])
  hashtags        String[]         @default([])
  imagePrompt     String?          @map("image_prompt") @db.Text
  seoKeywords     String[]         @default([]) @map("seo_keywords")
  currentVersion  Int              @default(1) @map("current_version")
  scheduledAt     DateTime?        @map("scheduled_at")
  publishedAt     DateTime?        @map("published_at")
  imageId         String?          @map("image_id")
  metadata        Json?
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  image           GeneratedImage?  @relation(fields: [imageId], references: [id], onDelete: SetNull)
  versions        ContentVersion[]
  calendarEntries CalendarEntry[]
  publishJobs     PublishJob[]

  @@index([companyId])
  @@index([status])
  @@index([scheduledAt])
  @@map("contents")
}

model ContentVersion {
  id          String   @id @default(uuid())
  contentId   String   @map("content_id")
  version     Int
  title       String
  copy        String   @db.Text
  cta         String?
  emojis      String[] @default([])
  hashtags    String[] @default([])
  imagePrompt String?  @map("image_prompt") @db.Text
  seoKeywords String[] @default([]) @map("seo_keywords")
  snapshot    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  content     Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([contentId, version])
  @@index([contentId])
  @@map("content_versions")
}

model GeneratedImage {
  id        String    @id @default(uuid())
  companyId String    @map("company_id")
  prompt    String    @db.Text
  storageKey String?  @map("storage_key")
  url       String?
  model     String
  createdAt DateTime  @default(now()) @map("created_at")

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contents  Content[]

  @@index([companyId])
  @@map("generated_images")
}

model CalendarEntry {
  id          String   @id @default(uuid())
  companyId   String   @map("company_id")
  contentId   String   @map("content_id")
  scheduledAt DateTime @map("scheduled_at")
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  content     Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([companyId, scheduledAt])
  @@index([contentId])
  @@map("calendar_entries")
}

model SocialConnection {
  id           String          @id @default(uuid())
  companyId    String          @map("company_id")
  platform     PublishPlatform
  externalId   String?         @map("external_id")
  displayName  String?         @map("display_name")
  accessToken  String?         @map("access_token") @db.Text
  refreshToken String?         @map("refresh_token") @db.Text
  metadata     Json?
  connectedAt  DateTime?       @map("connected_at")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  company      Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, platform])
  @@map("social_connections")
}

model PublishJob {
  id          String           @id @default(uuid())
  companyId   String           @map("company_id")
  contentId   String           @map("content_id")
  platform    PublishPlatform
  status      PublishJobStatus @default(PENDING)
  scheduledAt DateTime?        @map("scheduled_at")
  publishedAt DateTime?        @map("published_at")
  externalId  String?          @map("external_id")
  error       String?
  payload     Json?
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  content     Content          @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([contentId])
  @@map("publish_jobs")
}

enum AgentType {
  ORCHESTRATOR
  BRAND
  CONTENT
  IMAGE
  SEO
  SOCIAL
  ANALYTICS
  CAMPAIGN
  TREND
  PLANNER
}

enum AgentRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum RecommendationType {
  PUBLISH
  SCHEDULE
  RECYCLE
  CREATE_CONTENT
  PAUSE_CAMPAIGN
  REPEAT_CAMPAIGN
  CREATE_PROMOTION
  TARGET_AUDIENCE
  AD_BUDGET
  FUNNEL
  MONTHLY_PLAN
  OTHER
}

enum RecommendationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXECUTED
}

model CompanyAiSettings {
  id                String   @id @default(uuid())
  companyId         String   @unique @map("company_id")
  contentProvider   String?  @map("content_provider")
  contentModel      String?  @map("content_model")
  imageProvider     String?  @map("image_provider")
  imageModel        String?  @map("image_model")
  reasoningProvider String?  @map("reasoning_provider")
  reasoningModel    String?  @map("reasoning_model")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_ai_settings")
}

model MetricsSnapshot {
  id           String   @id @default(uuid())
  companyId    String   @map("company_id")
  platform     String?
  periodStart  DateTime @map("period_start")
  periodEnd    DateTime @map("period_end")
  reach        Int      @default(0)
  likes        Int      @default(0)
  comments     Int      @default(0)
  shares       Int      @default(0)
  conversions  Int      @default(0)
  bestHours    Json?    @map("best_hours")
  raw          Json?
  source       String   @default("mock")
  createdAt    DateTime @default(now()) @map("created_at")

  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, periodEnd])
  @@map("metrics_snapshots")
}

model AgentRun {
  id              String             @id @default(uuid())
  companyId       String             @map("company_id")
  status          AgentRunStatus
  goal            String?
  summary         String?            @db.Text
  plan            Json?
  error           String?
  startedAt       DateTime?          @map("started_at")
  finishedAt      DateTime?          @map("finished_at")
  createdAt       DateTime           @default(now()) @map("created_at")

  steps           AgentStep[]
  recommendations Recommendation[]
  company         Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@map("agent_runs")
}

model AgentStep {
  id        String         @id @default(uuid())
  runId     String         @map("run_id")
  agent     AgentType
  status    AgentRunStatus
  input     Json?
  output    Json?
  provider  String?
  model     String?
  latencyMs Int?           @map("latency_ms")
  error     String?
  createdAt DateTime       @default(now()) @map("created_at")

  run       AgentRun       @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@map("agent_steps")
}

model Recommendation {
  id          String               @id @default(uuid())
  companyId   String               @map("company_id")
  runId       String?              @map("run_id")
  type        RecommendationType
  title       String
  description String               @db.Text
  priority    Int                  @default(0)
  payload     Json?
  status      RecommendationStatus @default(PENDING)
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  company     Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  run         AgentRun?            @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([companyId, status])
  @@map("recommendations")
}
